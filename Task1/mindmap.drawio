          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-38" value="Платежи по ЖКУ (потеря данных - значительный)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="430" y="650" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-89" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="eKt4zGXAnMbcLxMi73FN-43" target="eKt4zGXAnMbcLxMi73FN-73">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-43" value="Договоры с клиентами и партнерами&lt;br&gt;(утечка данных - критический, обесценивание данных, искажение данных - значительный)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="610" y="650" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eKt4zGXAnMbcLxMi73FN-51" target="eKt4zGXAnMbcLxMi73FN-80">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-51" value="Пароли и API-ключи (утечка - критический, искажение - значительный)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-100" y="170" width="110" height="95" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eKt4zGXAnMbcLxMi73FN-52" target="eKt4zGXAnMbcLxMi73FN-79">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-52" value="&amp;nbsp;Доступ к видеонаблюдению (утечка - значительный, потеря - значительный)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-100" y="300" width="110" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eKt4zGXAnMbcLxMi73FN-53" target="eKt4zGXAnMbcLxMi73FN-78">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-53" value="Ключи шифрования (утечка - критический, искажение, обесценивание - значительный" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-100" y="440" width="110" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-65" value="Некачественные данные адресов могут ввести в заблуждение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="-100" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-66" value="Фото недвижимости могут устареть&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="-100" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-67" value="Некорректные условия и цены могут привести к жалобам и репутационным потерям" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="-120" width="110" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-68" value="Планы проведения ремонтных работ должны быть актуальны, иначе введут в заблуждение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="-100" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-69" value="Внутренние инструкции - утечка может привести к получению злоумышленником важных данных относительно процессов, что может стать инструментом для мошенничества&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="143" width="220" height="84" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-70" value="Утечка контактов подрядчиков может быть полезна конкурентам" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="253" width="110" height="84" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-71" value="Аналогично с внтуренними инструкциями могут быть использованы мошенником" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="363" width="110" height="84" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-72" value="Может быть использована для попыток коррупции, если будет известен процесс и лица, участвующие в нем" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="473" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-73" value="Договоры с клиентами и партнерами.&lt;br&gt;Договоры также содержат персональные данные клиентов, а так же условия сделок и должны быть защищены" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="810" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-74" value="Утрата данных по платежам может вызвать поток жалоб со стороны клиентов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="810" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-75" value="Некорректные или устаревшие реквизиты партнеров приведут к невозможности пользоваться услугами оплаты ЖКХ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="810" width="110" height="140" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-76" value="Утрата данных по&amp;nbsp; сделкам может усложнить отчетность и обслуживание клиентов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="810" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-77" value="Утечка персональных данных может привести к очень серьезным последствиям для безопасности и репутации компании" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="-20" y="810" width="110" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-78" value="Компроментация ключей шифрования может привести к утечке других важных данных. Их несвоевременное обновление или искажение может повлиять на работоспособность системы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="-380" y="440" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-79" value="Несанкционированный доступ к видеозаписям объектов несет прямую угрозу жителям и может использоваться злоумышленниками" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="-380" y="300" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eKt4zGXAnMbcLxMi73FN-80" value="Пароли и API-ключи. Утечка может привести к неработоспособности или даже утраты части функционала. Утечка паролей может привести к значительному репутационному ущербу" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;glass=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="-380" y="170" width="240" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
